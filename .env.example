# ==============================================================================
# The Rental Circle - Production Environment Variables
# ==============================================================================

# Application URL
BETTER_AUTH_URL="https://app.therentalcircle.in"
BETTER_AUTH_SECRET="your-32-byte-hex-secret-or-random-string"

# Authentication (Google OAuth - Optional for pilot, fallback to Email OTP / Test Personas)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cryptography & Blind Indexing (256-bit Hex Key for AES-256-GCM / HMAC)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRC_CRYPTO_KEY="your-256-bit-hex-encryption-key"

# Cloudflare R2 Object Storage (For Private Quarantine & Public Media)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Transactional Email (Resend - Optional)
RESEND_API_KEY="re_123456789"
